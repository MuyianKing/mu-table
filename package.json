{
  "name": "@muyianking/table",
  "type": "module",
  "version": "0.1.4",
  "homepage": "https://muyianking.github.io/blog/docs/table/home.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuyianKing/mu-table.git"
  },
  "keywords": [
    "MIT",
    "vue3",
    "table",
    "typescript"
  ],
  "module": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "commit": "git add . && git cz",
    "dev": "vite --host",
    "release": "node ./script/publish.js",
    "preview": "vite preview",
    "update-deps": "npm-check-updates & ncu -u & pnpm i",
    "log": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build": "node ./script/build.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.5.1",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@muyianking/build": "^0.0.4",
    "@muyianking/config": "^0.0.8",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.1.0",
    "fs-extra": "^11.3.2",
    "inquirer": "^13.0.2",
    "lint-staged": "^16.2.7",
    "ora": "^9.0.0",
    "sass": "^1.94.2",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.1.7"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}